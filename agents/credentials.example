# =============================================================================
#  Fichier d'identifiants pour install-agent.sh (--creds <fichier>)
#
#  1) Copiez-le hors du dépôt :  cp agents/credentials.example /root/wazuh-creds
#  2) Protégez-le (obligatoire, sinon refus) :  chmod 600 /root/wazuh-creds
#  3) Utilisez-le :  ./agents/install-agent.sh 192.168.1.0/24 --creds /root/wazuh-creds
#
#  Les options -u / -p / -k de la ligne de commande sont prioritaires et
#  s'appliquent à tous les OS. Format : CLE=valeur (une par ligne).
# =============================================================================

# --- Linux (SSH + sudo) ------------------------------------------------------
LINUX_USER=admin
LINUX_PASS=
# Clé privée SSH (prioritaire sur le mot de passe pour la connexion ;
# le mot de passe sert alors uniquement à sudo si nécessaire)
LINUX_KEY=/root/.ssh/id_ed25519

# --- macOS (SSH « Session à distance » + compte administrateur) --------------
MAC_USER=admin
MAC_PASS=
MAC_KEY=

# --- Windows (WinRM, compte administrateur) ----------------------------------
# Domaine : CORP\administrateur   ou   administrateur@corp.local
# Workgroup : compte administrateur local (voir active-winRm.ps1)
WIN_USER=CORP\administrateur
WIN_PASS=
# negotiate (défaut, Kerberos puis NTLM) | ntlm | kerberos
WIN_AUTH=negotiate
# yes = WinRM HTTPS (5986)
WIN_HTTPS=no

# --- Raccourci : mêmes identifiants SSH pour Linux et macOS ------------------
# SSH_USER=admin
# SSH_PASS=
# SSH_KEY=/root/.ssh/id_ed25519
